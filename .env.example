# ---------------------------------------------------------------
# Environment variables for the Australian Payroll Association CRM.
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# ---------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE=
SUPABASE_SERVICE_ROLE_KEY=
# Database password — Project Settings → Database (used only by migration scripts)
SUPABASE_DB_PASSWORD=

# App — your live domain (used for email links, redirects)
NEXT_PUBLIC_SITE_URL=

# Resend — resend.com → API Keys (Build 2: confirmation emails)
# RESEND_API_KEY=
